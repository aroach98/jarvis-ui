# jarvis-core reads all of these at runtime. This file documents names only —
# never put real values here or in a committed .env. See ARCHITECTURE.md §7.

# Vault-backed (CACC / Momentum): these are User-scope Windows env vars set
# outside this project, NOT meant to live in a local .env file. jarvis-core
# reads them the same way every other agent on this machine does.
#   CACC_VAULT_TOKEN
#   MOMENTUM_VAULT_TOKEN

# Personal secrets (pro-mode reasoning + TTS, Spotify easter egg). Source of
# truth is E:\Desktop\Secrets.xlsx; copy the values you need into a local,
# gitignored .env.local — never .env, never committed.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Local service config, not secret.
JARVIS_WS_PORT=8721
